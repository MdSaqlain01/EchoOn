# Copy to .env and fill in. Do not commit .env.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Optional: for more accurate translations (Google Cloud Translation API).
# Get a key at https://console.cloud.google.com/apis/credentials (enable Cloud Translation API).
# Leave empty to use free LibreTranslate + MyMemory.
GOOGLE_TRANSLATE_API_KEY=
